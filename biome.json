{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": ["src/**", "vite.config.ts", "tsconfig.json", "biome.json", "package.json"]
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": { "noImportantStyles": "off" },
      "correctness": { "useExhaustiveDependencies": "error", "useHookAtTopLevel": "error" },
      "a11y": { "recommended": true }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
